{
  "name": "resume-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare-content": "node scripts/prepare.mjs",
    "prepare": "svelte-kit sync || echo",
    "predev": "npm run prepare-content",
    "dev": "vite dev",
    "prebuild": "svelte-kit sync && npm run prepare-content",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.54.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.19.5",
    "mdsvex": "^0.12.8",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "@sveltejs/kit": "$@sveltejs/kit"
  }
}
