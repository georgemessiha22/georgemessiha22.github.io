  { {{- esc .Location -}} }
  { {{- esc .Mode -}} }
  {
{{- if .Intro }}
{{ emph .Intro }}
{{- end }}
{{- if .Bullets }}
\begin{itemize}
{{- range .Bullets }}
  \item {{ emph . }}
{{- end }}
\end{itemize}
{{- end }}
}
{{ end }}
\section{Education}
{{ range .Education }}\cventry
  { {{- esc .Start }}{{ if .End }}--{{ esc .End }}{{ end -}} }
