% its FontAwesome social icons itself, so we only set fonts + style/color here.
\moderncvstyle{banking}
\moderncvcolor{grey}
\usepackage[hscale=0.8,top=1.9cm, bottom=1.9cm]{geometry}
\usepackage{fontspec}
\setsansfont{TeX Gyre Heros}
\setmainfont{TeX Gyre Heros}
\renewcommand{\familydefault}{\sfdefault}
\usepackage{multicol}
\usepackage[unicode,pdfpagelabels=false]{hyperref}
\definecolor{airforceblue}{rgb}{0.36, 0.54, 0.66}
\hypersetup{colorlinks=true, linkcolor=airforceblue, urlcolor=airforceblue}
\nopagenumbers{}
\firstname{ {{- esc .Contact.Firstname -}} }
\familyname{ {{- esc .Contact.Lastname -}} }
\title{ {{- esc .Contact.Title -}} }
\address{ {{- esc .Contact.Location -}} }{}
\begin{document}
\makecvtitle
\begin{center}\small{} {{ range $i, $c := contact . }}{{ if eq $i 2 }}\\{{ else if $i }} \textbar{} {{ end }}{{ esc $c }}{{ end }}\end{center}

