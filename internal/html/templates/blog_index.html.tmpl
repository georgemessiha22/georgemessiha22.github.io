<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Blog — {{ .Resume.Contact.Firstname }} {{ .Resume.Contact.Lastname }}</title>
<link rel="stylesheet" href="../style.css">
</head>
<body>
<nav class="site-nav">
  <a href="../index.html">Résumé</a>
  <a class="active" href="index.html">Blog</a>
</nav>
<header class="top">
  <div>
    <h1>Blog</h1>
    <div class="title">{{ .Resume.Contact.Firstname }} {{ .Resume.Contact.Lastname }}</div>
  </div>
</header>

<section>
  <div class="post-list">
  {{- range .Posts }}
    <article class="post-card">
      <h2 class="post-title"><a href="{{ .Slug }}/index.html">{{ .Title }}</a></h2>
      {{- if .Date }}<div class="post-date">{{ .Date }}</div>{{ end }}
      {{- if .Summary }}<p class="post-summary">{{ .Summary }}</p>{{ end }}
      <a class="read-more" href="{{ .Slug }}/index.html">Read →</a>
    </article>
  {{- end }}
  </div>
</section>
</body>
</html>
